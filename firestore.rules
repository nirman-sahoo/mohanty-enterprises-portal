rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidInventory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.category is string &&
             data.stockLevel is number &&
             data.unit is string &&
             data.unitPrice is number;
    }

    function isValidOrder(data) {
      return data.orderNo is string && data.orderNo.size() <= 64 &&
             data.invoiceNo is string && data.invoiceNo.size() <= 64 &&
             data.customerName is string && data.customerName.size() <= 160 &&
             data.totalAmount is number &&
             data.status is string &&
             data.paymentStatus is string;
    }

    function isValidLedger(data) {
      return data.name is string && data.name.size() <= 160 &&
             data.totalBilled is number &&
             data.totalPaid is number &&
             data.outstandingReceivable is number;
    }

    function isValidReceipt(data) {
      return data.receiptNo is string && data.receiptNo.size() <= 64 &&
             data.partyName is string && data.partyName.size() <= 160 &&
             data.amount is number &&
             data.paymentMode is string;
    }

    function isValidPaymentVoucher(data) {
      return data.voucherNo is string && data.voucherNo.size() <= 64 &&
             data.supplierName is string && data.supplierName.size() <= 160 &&
             data.amount is number &&
             data.paymentMode is string &&
             data.bankAccountId is string;
    }

    function isValidPurchase(data) {
      return data.purchaseNo is string && data.purchaseNo.size() <= 64 &&
             data.totalAmount is number &&
             data.supplierName is string;
    }

    function isValidBankAccount(data) {
      return (data.accountNumber is string || data.accountNo is string) &&
             data.bankName is string &&
             data.currentBalance is number;
    }

    function isValidContra(data) {
      return (data.voucherNo is string || data.contraNo is string) &&
             data.amount is number &&
             data.fromAccount is string &&
             data.toAccount is string;
    }

    function isValidSettings(data) {
      return data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 160 &&
             data.gstin is string && data.gstin.size() <= 40;
    }

    // Master Inventory Catalog & Stock
    match /inventory/{itemId} {
      allow read: if true;
      allow create: if isValidId(itemId) && isValidInventory(incoming());
      allow update: if isValidId(itemId) && isValidInventory(incoming());
      allow delete: if isValidId(itemId);
    }

    // Sales Vouchers & Commercial Invoices
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isValidId(orderId);
    }

    // Party Outstandings & Receivables Ledger
    match /ledgers/{ledgerId} {
      allow read: if true;
      allow create: if isValidId(ledgerId) && isValidLedger(incoming());
      allow update: if isValidId(ledgerId) && isValidLedger(incoming());
      allow delete: if isValidId(ledgerId);
    }

    // Official Customer Receipt Vouchers
    match /money_receipts/{receiptId} {
      allow read: if true;
      allow create: if isValidId(receiptId) && isValidReceipt(incoming());
      allow update: if isValidId(receiptId) && isValidReceipt(incoming());
      allow delete: if isValidId(receiptId);
    }

    // Supplier Payment Vouchers
    match /payment_vouchers/{voucherId} {
      allow read: if true;
      allow create: if isValidId(voucherId) && isValidPaymentVoucher(incoming());
      allow update: if isValidId(voucherId) && isValidPaymentVoucher(incoming());
      allow delete: if isValidId(voucherId);
    }

    // Purchase Vouchers & Procurement
    match /purchases/{purchaseId} {
      allow read: if true;
      allow create: if isValidId(purchaseId) && isValidPurchase(incoming());
      allow update: if isValidId(purchaseId) && isValidPurchase(incoming());
      allow delete: if isValidId(purchaseId);
    }

    // Company Bank & Cash Drawer Accounts
    match /bank_accounts/{accId} {
      allow read: if true;
      allow create: if isValidId(accId) && isValidBankAccount(incoming());
      allow update: if isValidId(accId) && isValidBankAccount(incoming());
      allow delete: if isValidId(accId);
    }

    // Bank Contra Transfers
    match /contra_entries/{contraId} {
      allow read: if true;
      allow create: if isValidId(contraId) && isValidContra(incoming());
      allow update: if isValidId(contraId) && isValidContra(incoming());
      allow delete: if isValidId(contraId);
    }

    // Enterprise & Terminal Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isValidId(settingId) && isValidSettings(incoming());
      allow update: if isValidId(settingId) && isValidSettings(incoming());
      allow delete: if isValidId(settingId);
    }
  }
}
