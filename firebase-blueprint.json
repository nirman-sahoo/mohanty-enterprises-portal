{
  "entities": {
    "inventoryItem": {
      "title": "Inventory Item",
      "description": "Wholesale catalog item for Cement, TMT Rods, Fertilizers, and Asbestos",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["CEMENT", "SCAN TMT BAR", "FERTILIZER", "Asbestos"] },
        "stockLevel": { "type": "number" },
        "unit": { "type": "string", "enum": ["Bags", "Tons", "KG", "Pcs", "CFT", "Bags/Bottles"] },
        "reorderLevel": { "type": "number" },
        "unitPrice": { "type": "number" },
        "hsnCode": { "type": "string", "maxLength": 20 },
        "isCriticalLow": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "stockLevel", "unit", "unitPrice"]
    },
    "orderRecord": {
      "title": "Sales Voucher Record",
      "description": "B2B wholesale sales voucher and invoice record",
      "type": "object",
      "properties": {
        "orderNo": { "type": "string", "maxLength": 50 },
        "invoiceNo": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerGstin": { "type": "string", "maxLength": 30 },
        "shipToAddress": { "type": "string", "maxLength": 250 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 50 },
        "itemDescription": { "type": "string", "maxLength": 150 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 20 },
        "unitPrice": { "type": "number" },
        "subtotal": { "type": "number" },
        "isGst": { "type": "boolean" },
        "gstRate": { "type": "number" },
        "gstAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending Verification", "Confirmed", "In Transit", "Delivered", "Cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Credit", "Partial"] },
        "paymentMode": { "type": "string", "maxLength": 50 },
        "paidAmount": { "type": "number" },
        "bankAccountId": { "type": "string", "maxLength": 80 },
        "bankAccountName": { "type": "string", "maxLength": 120 },
        "paymentReference": { "type": "string", "maxLength": 80 },
        "truckNumber": { "type": "string", "maxLength": 30 }
      },
      "required": ["orderNo", "invoiceNo", "customerName", "totalAmount", "status", "paymentStatus"]
    },
    "customerLedger": {
      "title": "Customer Ledger Record",
      "description": "Party master record and Khatabook credit balance",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "gstin": { "type": "string", "maxLength": 30 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 250 },
        "shipToAddress": { "type": "string", "maxLength": 250 },
        "openingBalance": { "type": "number" },
        "totalBilled": { "type": "number" },
        "totalPaid": { "type": "number" },
        "outstandingReceivable": { "type": "number" },
        "totalOverdue": { "type": "number" },
        "creditLimit": { "type": "number" },
        "creditDays": { "type": "number" },
        "lastPaymentDate": { "type": "string", "maxLength": 20 },
        "lastTransactionDate": { "type": "string", "maxLength": 20 },
        "averageCollectionDays": { "type": "number" },
        "oldestDueDays": { "type": "number" },
        "nextFollowUpDate": { "type": "string", "maxLength": 20 },
        "followUpNote": { "type": "string", "maxLength": 300 },
        "promisesToPay": { "type": "string", "maxLength": 300 }
      },
      "required": ["name", "phone", "totalBilled", "totalPaid", "outstandingReceivable"]
    },
    "moneyReceipt": {
      "title": "Money Receipt Record",
      "description": "Official cash/bank money receipt voucher from customer",
      "type": "object",
      "properties": {
        "receiptNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "partyName": { "type": "string", "maxLength": 150 },
        "partyAddress": { "type": "string", "maxLength": 250 },
        "partyPhone": { "type": "string", "maxLength": 30 },
        "amount": { "type": "number" },
        "amountInWords": { "type": "string", "maxLength": 300 },
        "paymentMode": { "type": "string", "enum": ["Cash", "RTGS / NEFT", "UPI / QR", "Cheque / DD"] },
        "bankAccountId": { "type": "string", "maxLength": 80 },
        "bankAccountName": { "type": "string", "maxLength": 120 },
        "forAccount": { "type": "string", "maxLength": 150 },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "referenceNo": { "type": "string", "maxLength": 50 },
        "remarks": { "type": "string", "maxLength": 250 }
      },
      "required": ["receiptNo", "partyName", "amount", "paymentMode"]
    },
    "paymentVoucher": {
      "title": "Supplier Payment Voucher",
      "description": "Cash or bank payment voucher issued to supplier",
      "type": "object",
      "properties": {
        "voucherNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "supplierGst": { "type": "string", "maxLength": 30 },
        "purchaseId": { "type": "string", "maxLength": 80 },
        "purchaseNo": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["Cash", "RTGS / NEFT", "UPI / QR", "Cheque / DD"] },
        "bankAccountId": { "type": "string", "maxLength": 80 },
        "bankAccountName": { "type": "string", "maxLength": 120 },
        "referenceNo": { "type": "string", "maxLength": 80 },
        "remarks": { "type": "string", "maxLength": 250 },
        "updatedAt": { "type": "string" }
      },
      "required": ["voucherNo", "supplierName", "amount", "paymentMode", "bankAccountId"]
    },
    "bankAccount": {
      "title": "Bank Account Record",
      "description": "Operating bank account and headquarters cash drawer",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "branch": { "type": "string", "maxLength": 100 },
        "ifsc": { "type": "string", "maxLength": 20 },
        "accountType": { "type": "string", "enum": ["Current", "Cash Credit (CC)", "Cash Drawer"] },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "unclearedChequesCount": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Reconciled"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["bankName", "accountNumber", "currentBalance"]
    },
    "contraEntry": {
      "title": "Bank Contra Voucher",
      "description": "Funds transfer between company bank accounts and cash drawer",
      "type": "object",
      "properties": {
        "voucherNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "fromAccountId": { "type": "string", "maxLength": 80 },
        "fromAccount": { "type": "string", "maxLength": 100 },
        "toAccountId": { "type": "string", "maxLength": 80 },
        "toAccount": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "referenceNo": { "type": "string", "maxLength": 50 },
        "remarks": { "type": "string", "maxLength": 250 },
        "updatedAt": { "type": "string" }
      },
      "required": ["voucherNo", "fromAccount", "toAccount", "amount"]
    },
    "purchaseRecord": {
      "title": "Purchase Voucher Record",
      "description": "Manufacturer consignment and purchase voucher",
      "type": "object",
      "properties": {
        "purchaseNo": { "type": "string", "maxLength": 50 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "supplierGst": { "type": "string", "maxLength": 30 },
        "supplierPhone": { "type": "string", "maxLength": 30 },
        "supplierAddress": { "type": "string", "maxLength": 250 },
        "date": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 50 },
        "subtotal": { "type": "number" },
        "isGst": { "type": "boolean" },
        "gstRate": { "type": "number" },
        "gstAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Pending", "Partial"] },
        "paymentMode": { "type": "string", "maxLength": 50 },
        "paidAmount": { "type": "number" },
        "bankAccountId": { "type": "string", "maxLength": 80 },
        "bankAccountName": { "type": "string", "maxLength": 120 },
        "paymentReference": { "type": "string", "maxLength": 80 },
        "truckNumber": { "type": "string", "maxLength": 30 },
        "challanNo": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string" }
      },
      "required": ["purchaseNo", "supplierName", "totalAmount"]
    },
    "companySettings": {
      "title": "Company Configuration",
      "description": "Enterprise GSTIN, voucher prefix, and default accounting settings",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "maxLength": 150 },
        "directorName": { "type": "string", "maxLength": 100 },
        "gstin": { "type": "string", "maxLength": 30 },
        "pan": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "invoicePrefix": { "type": "string", "maxLength": 30 },
        "purchasePrefix": { "type": "string", "maxLength": 30 },
        "receiptPrefix": { "type": "string", "maxLength": 30 },
        "paymentPrefix": { "type": "string", "maxLength": 30 },
        "contraPrefix": { "type": "string", "maxLength": 30 },
        "defaultGstRate": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["companyName", "gstin"]
    }
  },
  "firestore": {
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/inventoryItem" },
      "description": "Warehouse stock levels and verified wholesale catalog"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/orderRecord" },
      "description": "B2B sales vouchers and commercial invoices"
    },
    "/ledgers/{ledgerId}": {
      "schema": { "$ref": "#/entities/customerLedger" },
      "description": "Party outstandings directory and credit ledger"
    },
    "/money_receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/moneyReceipt" },
      "description": "Official customer payment receipt vouchers"
    },
    "/payment_vouchers/{voucherId}": {
      "schema": { "$ref": "#/entities/paymentVoucher" },
      "description": "Supplier payment vouchers linked to payables and cash/bank books"
    },
    "/bank_accounts/{accId}": {
      "schema": { "$ref": "#/entities/bankAccount" },
      "description": "Operating bank accounts and headquarters cash drawer"
    },
    "/contra_entries/{contraId}": {
      "schema": { "$ref": "#/entities/contraEntry" },
      "description": "Internal contra transfers between cash and bank accounts"
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/purchaseRecord" },
      "description": "Manufacturer purchase vouchers and inward challans"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/companySettings" },
      "description": "Company configuration, GSTIN, and voucher numbering settings"
    }
  }
}
