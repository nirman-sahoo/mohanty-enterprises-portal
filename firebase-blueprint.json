{
  "entities": {
    "inventoryItem": {
      "title": "Inventory Item",
      "description": "Wholesale catalog item for Cement, TMT Rods, Fertilizers, and Asbestos",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["CEMENT", "SCAN TMT BAR", "FERTILIZER", "Asbestos"] },
        "stockLevel": { "type": "number" },
        "unit": { "type": "string", "enum": ["Bags", "Tons", "KG", "Pcs", "CFT", "Bags/Bottles"] },
        "reorderLevel": { "type": "number" },
        "unitPrice": { "type": "number" },
        "hsnCode": { "type": "string", "maxLength": 20 },
        "isCriticalLow": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "stockLevel", "unit", "unitPrice"]
    },
    "orderRecord": {
      "title": "Commercial Order Record",
      "description": "B2B wholesale order and invoice record",
      "type": "object",
      "properties": {
        "orderNo": { "type": "string", "maxLength": 50 },
        "invoiceNo": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 150 },
        "shipToAddress": { "type": "string", "maxLength": 250 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 50 },
        "itemDescription": { "type": "string", "maxLength": 150 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 20 },
        "unitPrice": { "type": "number" },
        "subtotal": { "type": "number" },
        "isGst": { "type": "boolean" },
        "gstAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending Verification", "Confirmed", "In Transit", "Delivered", "Cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Credit", "Partial"] },
        "truckNumber": { "type": "string", "maxLength": 30 }
      },
      "required": ["orderNo", "invoiceNo", "customerName", "totalAmount", "status", "paymentStatus"]
    },
    "customerLedger": {
      "title": "Customer Ledger Record",
      "description": "Party master record and Khatabook credit balance",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "gstin": { "type": "string", "maxLength": 30 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 250 },
        "shipToAddress": { "type": "string", "maxLength": 250 },
        "totalBilled": { "type": "number" },
        "totalPaid": { "type": "number" },
        "outstandingReceivable": { "type": "number" },
        "totalOverdue": { "type": "number" },
        "creditLimit": { "type": "number" },
        "creditDays": { "type": "number" },
        "lastPaymentDate": { "type": "string", "maxLength": 20 },
        "lastTransactionDate": { "type": "string", "maxLength": 20 },
        "averageCollectionDays": { "type": "number" },
        "oldestDueDays": { "type": "number" },
        "nextFollowUpDate": { "type": "string", "maxLength": 20 },
        "followUpNote": { "type": "string", "maxLength": 300 },
        "promisesToPay": { "type": "string", "maxLength": 300 }
      },
      "required": ["name", "phone", "totalBilled", "totalPaid", "outstandingReceivable"]
    },
    "moneyReceipt": {
      "title": "Money Receipt Record",
      "description": "Official cash/bank money receipt voucher",
      "type": "object",
      "properties": {
        "receiptNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "partyName": { "type": "string", "maxLength": 150 },
        "partyAddress": { "type": "string", "maxLength": 250 },
        "partyPhone": { "type": "string", "maxLength": 30 },
        "amount": { "type": "number" },
        "amountInWords": { "type": "string", "maxLength": 300 },
        "paymentMode": { "type": "string", "enum": ["Cash", "RTGS / NEFT", "UPI / QR", "Cheque / DD"] },
        "forAccount": { "type": "string", "maxLength": 150 },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "referenceNo": { "type": "string", "maxLength": 50 }
      },
      "required": ["receiptNo", "partyName", "amount", "paymentMode"]
    },
    "bankAccount": {
      "title": "Bank Account Record",
      "description": "Operating bank account and safe cash drawer",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "branch": { "type": "string", "maxLength": 100 },
        "ifsc": { "type": "string", "maxLength": 20 },
        "accountType": { "type": "string", "enum": ["Current", "Cash Credit (CC)", "Cash Drawer"] },
        "currentBalance": { "type": "number" },
        "unclearedChequesCount": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Reconciled"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["bankName", "accountNumber", "currentBalance"]
    },
    "contraEntry": {
      "title": "Bank Contra Voucher",
      "description": "Funds transfer between company accounts and cash drawer",
      "type": "object",
      "properties": {
        "voucherNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "fromAccount": { "type": "string", "maxLength": 100 },
        "toAccount": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "referenceNo": { "type": "string", "maxLength": 50 },
        "remarks": { "type": "string", "maxLength": 250 },
        "updatedAt": { "type": "string" }
      },
      "required": ["voucherNo", "fromAccount", "toAccount", "amount"]
    },
    "expenseRecord": {
      "title": "Expense Voucher",
      "description": "Operating and administrative expense record",
      "type": "object",
      "properties": {
        "expenseNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "paymentMode": { "type": "string", "maxLength": 50 },
        "paidTo": { "type": "string", "maxLength": 100 },
        "approvedBy": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["Approved", "Pending", "Rejected"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["expenseNo", "category", "amount"]
    },
    "purchaseRecord": {
      "title": "Procurement Purchase Record",
      "description": "Manufacturer consignment and purchase order",
      "type": "object",
      "properties": {
        "purchaseNo": { "type": "string", "maxLength": 50 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "supplierGst": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 50 },
        "subtotal": { "type": "number" },
        "gstAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Pending", "Partial"] },
        "truckNumber": { "type": "string", "maxLength": 30 },
        "challanNo": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string" }
      },
      "required": ["purchaseNo", "supplierName", "totalAmount"]
    },
    "accountHead": {
      "title": "Account Head",
      "description": "Chart of accounts master head",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 20 },
        "name": { "type": "string", "maxLength": 100 },
        "group": { "type": "string", "maxLength": 50 },
        "balance": { "type": "number" },
        "balanceType": { "type": "string", "enum": ["Dr", "Cr"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["code", "name", "group"]
    },
    "journalEntry": {
      "title": "Journal Voucher Entry",
      "description": "Double-entry book adjustment voucher",
      "type": "object",
      "properties": {
        "jvNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "debitAccount": { "type": "string", "maxLength": 100 },
        "debitAmount": { "type": "number" },
        "creditAccount": { "type": "string", "maxLength": 100 },
        "creditAmount": { "type": "number" },
        "narration": { "type": "string", "maxLength": 250 },
        "authorizedBy": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string" }
      },
      "required": ["jvNo", "debitAmount", "creditAmount"]
    },
    "employee": {
      "title": "Employee Profile",
      "description": "Staff master profile",
      "type": "object",
      "properties": {
        "empCode": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "department": { "type": "string", "maxLength": 50 },
        "designation": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "monthlySalary": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "On Leave", "Inactive"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["empCode", "name", "department", "monthlySalary"]
    },
    "attendanceRecord": {
      "title": "Daily Attendance Log",
      "description": "Daily employee attendance log",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "maxLength": 50 },
        "employeeName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Present", "Absent", "On Leave", "Half Day"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["employeeId", "date", "status"]
    },
    "payrollRecord": {
      "title": "Monthly Payroll Record",
      "description": "Staff salary disbursement record",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "maxLength": 50 },
        "employeeName": { "type": "string", "maxLength": 150 },
        "month": { "type": "string", "maxLength": 30 },
        "netSalary": { "type": "number" },
        "status": { "type": "string", "enum": ["Processed", "Paid", "Hold"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["employeeId", "month", "netSalary"]
    },
    "leaveRequest": {
      "title": "Leave Request",
      "description": "Staff leave approval application",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "maxLength": 50 },
        "employeeName": { "type": "string", "maxLength": 150 },
        "leaveType": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["employeeId", "leaveType", "status"]
    }
  },
  "firestore": {
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/inventoryItem" },
      "description": "Warehouse stock levels and verified wholesale catalog"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/orderRecord" },
      "description": "B2B sales and multi-item commercial orders"
    },
    "/ledgers/{ledgerId}": {
      "schema": { "$ref": "#/entities/customerLedger" },
      "description": "Khatabook contractor directory and credit ledger"
    },
    "/money_receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/moneyReceipt" },
      "description": "Official payment receipt vouchers with amount in words"
    },
    "/bank_accounts/{accId}": {
      "schema": { "$ref": "#/entities/bankAccount" },
      "description": "Operating bank accounts and headquarters cash drawer"
    },
    "/contra_entries/{contraId}": {
      "schema": { "$ref": "#/entities/contraEntry" },
      "description": "Internal contra transfers between cash and bank accounts"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/expenseRecord" },
      "description": "Operating logistics, yard, and office expenses"
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/purchaseRecord" },
      "description": "Manufacturer procurement orders and inward challans"
    },
    "/account_heads/{headId}": {
      "schema": { "$ref": "#/entities/accountHead" },
      "description": "Chart of account heads for ledger classification"
    },
    "/journal_vouchers/{jvId}": {
      "schema": { "$ref": "#/entities/journalEntry" },
      "description": "Double-entry journal vouchers"
    },
    "/employees/{empId}": {
      "schema": { "$ref": "#/entities/employee" },
      "description": "Employee master roster records"
    },
    "/attendance_logs/{logId}": {
      "schema": { "$ref": "#/entities/attendanceRecord" },
      "description": "Daily employee attendance check-ins"
    },
    "/payroll_records/{recordId}": {
      "schema": { "$ref": "#/entities/payrollRecord" },
      "description": "Monthly employee payroll statements"
    },
    "/leave_requests/{requestId}": {
      "schema": { "$ref": "#/entities/leaveRequest" },
      "description": "Staff leave applications and approvals"
    }
  }
}
